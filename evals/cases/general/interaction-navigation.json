{
  "version": 1,
  "id": "general.interaction.navigation",
  "suite": "general",
  "tags": ["interaction", "navigation"],
  "description": "Clarify and cancel a question through prompt-bound native controls.",
  "task": "Ask me one question using the interactive question controls: whether I prefer email or paper for this synthetic test. Wait for my answer; do not guess a preference.",
  "requires": ["conversation", "interactions"],
  "fixtures": [],
  "driver": {
    "mode": "scripted",
    "steps": [
      {"wait_for": {"kind": "question"}, "action": {"kind": "clarify"}},
      {"wait_for": {"kind": "question"}, "action": {"kind": "cancel"}}
    ]
  },
  "limits": {"max_user_turns": 3, "turn_timeout": "3m", "case_timeout": "8m", "max_driver_calls": 1},
  "checks": [
    {"id": "native-question", "kind": "interaction_observed"},
    {"id": "same-session", "kind": "same_session"}
  ],
  "rubric": []
}
