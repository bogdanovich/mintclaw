{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mintclaw.dev/schemas/nodes/command-descriptor.v1.json",
  "title": "MintClaw node command descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "input_schema", "output_schema", "risk"],
  "properties": {
    "name": {"type": "string", "maxLength": 128, "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)*\\.v[1-9][0-9]*$"},
    "input_schema": {"type": "object"},
    "output_schema": {"type": "object"},
    "risk": {"enum": ["read", "write", "privileged"]},
    "supports_progress": {"type": "boolean"},
    "supports_cancel": {"type": "boolean"},
    "model_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "availability",
        "timeout_seconds_max",
        "output_bytes_max",
        "result_kind",
        "constraints",
        "guidance",
        "examples"
      ],
      "properties": {
        "availability": {"enum": ["available", "partially_described", "unavailable"]},
        "timeout_seconds_max": {"type": "integer", "minimum": 1, "maximum": 3600},
        "output_bytes_max": {"type": "integer", "minimum": 1, "maximum": 524288},
        "result_kind": {"const": "json"},
        "authority_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "approval_mode": {"enum": ["each_command", "session_start"]},
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "executable_aliases": {
              "type": "array",
              "maxItems": 64,
              "items": {"type": "string", "minLength": 1, "maxLength": 64}
            },
            "profile_aliases": {
              "type": "array",
              "maxItems": 32,
              "items": {"type": "string", "minLength": 1, "maxLength": 64}
            },
            "working_scopes": {
              "type": "array",
              "maxItems": 32,
              "items": {"type": "string", "minLength": 1, "maxLength": 64}
            },
            "environment_names": {
              "type": "array",
              "maxItems": 64,
              "items": {"type": "string", "minLength": 1, "maxLength": 64}
            }
          }
        },
        "guidance": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 2048}
        },
        "examples": {
          "type": "array",
          "maxItems": 4,
          "items": {"type": "object"}
        }
      }
    },
    "service_profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["alias", "revision", "manager", "services", "log_limits", "action_approval"],
        "properties": {
          "alias": {"type": "string", "minLength": 1, "maxLength": 64},
          "revision": {"type": "string", "minLength": 1, "maxLength": 128},
          "manager": {"const": "systemd"},
          "services": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["alias"],
              "properties": {
                "alias": {"type": "string", "minLength": 1, "maxLength": 64},
                "description": {"type": "string", "maxLength": 256},
                "status": {"type": "boolean"},
                "logs": {"type": "boolean"},
                "actions": {
                  "type": "array",
                  "maxItems": 6,
                  "items": {"enum": ["start", "stop", "restart", "reload", "enable", "disable"]}
                }
              }
            }
          },
          "log_limits": {
            "type": "object",
            "additionalProperties": false,
            "required": ["entries_max", "bytes_max", "age_seconds_max"],
            "properties": {
              "entries_max": {"type": "integer", "minimum": 1, "maximum": 500},
              "bytes_max": {"type": "integer", "minimum": 1, "maximum": 262144},
              "age_seconds_max": {"type": "integer", "minimum": 1, "maximum": 604800}
            }
          },
          "action_approval": {"enum": ["required", "operator_bypass_configured"]}
        }
      }
    },
    "job_profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alias", "revision", "executor", "authority_digest",
          "timeout_seconds_max", "concurrent_jobs", "stdout_bytes_max",
          "stderr_bytes_max", "artifact_count_max", "artifact_bytes_max",
          "artifacts_total_bytes_max", "retention_seconds",
          "cancel_guarantee", "executable_aliases", "working_scopes",
          "environment_names", "approval"
        ],
        "properties": {
          "alias": {"type": "string", "minLength": 1, "maxLength": 64},
          "revision": {"type": "string", "minLength": 1, "maxLength": 128},
          "executor": {"const": "system_exec"},
          "authority_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "timeout_seconds_max": {"type": "integer", "minimum": 1, "maximum": 86400},
          "concurrent_jobs": {"type": "integer", "minimum": 1, "maximum": 32},
          "stdout_bytes_max": {"type": "integer", "minimum": 1, "maximum": 67108864},
          "stderr_bytes_max": {"type": "integer", "minimum": 1, "maximum": 67108864},
          "artifact_count_max": {"type": "integer", "minimum": 1, "maximum": 16},
          "artifact_bytes_max": {"type": "integer", "minimum": 1, "maximum": 536870912},
          "artifacts_total_bytes_max": {"type": "integer", "minimum": 1, "maximum": 1073741824},
          "retention_seconds": {"type": "integer", "minimum": 60, "maximum": 2592000},
          "cancel_guarantee": {"enum": ["direct_process", "process_group"]},
          "executable_aliases": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {"type": "string", "minLength": 1, "maxLength": 64}
          },
          "working_scopes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {"type": "string", "minLength": 1, "maxLength": 64}
          },
          "environment_names": {
            "type": "array",
            "maxItems": 64,
            "items": {"type": "string", "minLength": 1, "maxLength": 128}
          },
          "approval": {
            "type": "object",
            "additionalProperties": false,
            "required": ["start", "read", "cancel"],
            "properties": {
              "start": {"enum": ["none", "required"]},
              "read": {"enum": ["none", "required"]},
              "cancel": {"enum": ["none", "required"]}
            }
          }
        }
      }
    },
    "browser_profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alias", "revision", "driver", "mode", "network_mode",
          "dry_run", "headed", "actions", "limits"
        ],
        "properties": {
          "alias": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "driver": {"const": "playwright_mcp"},
          "mode": {"const": "managed"},
          "network_mode": {"enum": ["exact_origins", "public_web", "any_http"]},
          "capability_mode": {"enum": ["full_access", "legacy_strict"]},
          "approval_mode": {"enum": ["none", "model_requested", "always_commit"]},
          "dry_run": {"type": "boolean"},
          "allow_approved_actions": {"type": "boolean"},
          "headed": {"type": "boolean"},
          "actions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "enum": [
                "check", "click", "dialog", "download", "drag", "file_chooser", "fill",
                "hover", "navigate", "press", "scroll", "select", "uncheck", "upload"
              ]
            }
          },
          "limits": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sessions", "tabs", "session_seconds", "idle_seconds",
              "prepared_seconds", "action_seconds", "snapshot_bytes",
              "screenshot_bytes", "upload_bytes", "download_bytes",
              "snapshot_refs", "text_input_bytes", "tool_result_bytes",
              "retention_seconds"
            ],
            "properties": {
              "sessions": {"const": 1},
              "tabs": {"type": "integer", "minimum": 1, "maximum": 4},
              "session_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
              "idle_seconds": {"type": "integer", "minimum": 1, "maximum": 600},
              "prepared_seconds": {"type": "integer", "minimum": 1, "maximum": 300},
              "action_seconds": {"type": "integer", "minimum": 1, "maximum": 60},
              "snapshot_bytes": {"type": "integer", "minimum": 1, "maximum": 262144},
              "screenshot_bytes": {"type": "integer", "minimum": 1, "maximum": 8388608},
              "upload_bytes": {"type": "integer", "minimum": 1, "maximum": 33554432},
              "download_bytes": {"type": "integer", "minimum": 1, "maximum": 33554432},
              "snapshot_refs": {"type": "integer", "minimum": 1, "maximum": 500},
              "text_input_bytes": {"type": "integer", "minimum": 1, "maximum": 16384},
              "tool_result_bytes": {"type": "integer", "minimum": 65536, "maximum": 327680},
              "retention_seconds": {"type": "integer", "minimum": 1, "maximum": 604800}
            }
          }
        }
      }
    },
    "update_profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alias", "revision", "channel", "approval", "current_version",
          "platform", "architecture", "releases"
        ],
        "properties": {
          "alias": {"type": "string", "minLength": 1, "maxLength": 64},
          "revision": {"type": "string", "minLength": 1, "maxLength": 128},
          "channel": {"enum": ["stable", "nightly"]},
          "approval": {"const": "required"},
          "current_version": {"type": "string", "minLength": 1, "maxLength": 64},
          "platform": {"enum": ["linux", "darwin"]},
          "architecture": {"enum": ["amd64", "arm64"]},
          "downgrade": {"type": "boolean"},
          "releases": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "alias", "version", "manifest_sha256", "artifact_sha256",
                "artifact_size", "authority_hash"
              ],
              "properties": {
                "alias": {"type": "string", "minLength": 1, "maxLength": 64},
                "version": {"type": "string", "minLength": 1, "maxLength": 64},
                "description": {"type": "string", "maxLength": 256},
                "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
                "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
                "artifact_size": {"type": "integer", "minimum": 1, "maximum": 134217728},
                "authority_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
              }
            }
          }
        }
      }
    }
  }
}
