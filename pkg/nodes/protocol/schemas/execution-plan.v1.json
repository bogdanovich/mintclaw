{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mintclaw.dev/schemas/nodes/execution-plan.v1.json",
  "title": "MintClaw node execution plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "invocation_id",
    "idempotency_key",
    "node_id",
    "catalog_hash",
    "command",
    "input",
    "agent_id",
    "session_id",
    "actor_id",
    "timeout_seconds",
    "output_limit_bytes",
    "prepared_at",
    "expires_at",
    "risk",
    "descriptor_hash",
    "executor",
    "policy_revision",
    "plan_hash"
  ],
  "properties": {
    "invocation_id": {"$ref": "#/$defs/identifier"},
    "idempotency_key": {"$ref": "#/$defs/identifier"},
    "node_id": {"$ref": "#/$defs/identifier"},
    "catalog_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "command": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)*\\.v[1-9][0-9]*$"
    },
    "service_profile": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "job_profile": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "update": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_id", "profile", "profile_revision", "release_alias",
        "release_version", "current_version", "platform", "architecture",
        "manifest_sha256", "artifact_sha256", "artifact_size", "authority_hash"
      ],
      "properties": {
        "execution_id": {"$ref": "#/$defs/identifier"},
        "profile": {"type": "string", "minLength": 1, "maxLength": 64},
        "profile_revision": {"$ref": "#/$defs/identifier"},
        "release_alias": {"type": "string", "minLength": 1, "maxLength": 64},
        "release_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "current_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "platform": {"enum": ["linux", "darwin"]},
        "architecture": {"enum": ["amd64", "arm64"]},
        "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "artifact_size": {"type": "integer", "minimum": 1, "maximum": 134217728},
        "authority_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "input": {"type": "object"},
    "agent_id": {"$ref": "#/$defs/identifier"},
    "session_id": {"$ref": "#/$defs/identifier"},
    "actor_id": {"$ref": "#/$defs/identifier"},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
    "output_limit_bytes": {"type": "integer", "minimum": 1, "maximum": 16777216},
    "prepared_at": {"type": "integer", "minimum": 1},
    "expires_at": {"type": "integer", "minimum": 1},
    "risk": {"enum": ["read", "write", "privileged"]},
    "descriptor_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "executor": {"$ref": "#/$defs/identifier"},
    "policy_revision": {"$ref": "#/$defs/identifier"},
    "plan_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    }
  }
}
