<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>org.mintclaw.credential-vm</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Library/PrivilegedHelperTools/mintclaw-credential-vm</string>
        <string>serve</string>
    </array>
    <key>UserName</key><string>_mintclawcredvm</string>
    <key>GroupName</key><string>_mintclawcredvm</string>
    <key>InitGroups</key><false/>
    <key>Disabled</key><true/>
    <key>RunAtLoad</key><false/>
    <key>KeepAlive</key><false/>
    <key>ProcessType</key><string>Standard</string>
    <key>Umask</key><integer>63</integer>
    <key>ExitTimeOut</key><integer>10</integer>
    <key>StandardInPath</key><string>/dev/null</string>
    <key>StandardOutPath</key><string>/dev/null</string>
    <key>StandardErrorPath</key><string>/dev/null</string>
    <key>SoftResourceLimits</key><dict><key>Core</key><integer>0</integer></dict>
    <key>HardResourceLimits</key><dict><key>Core</key><integer>0</integer></dict>
</dict>
</plist>
